{
  "name": "project-movie-back-end",
  "version": "2.7.0",
  "description": "zid-be-project-movie-01-qualified",
  "main": "src/app.js",
  "scripts": {
    "docker:build": "docker build --target runtime --tag kernel528/welovemovies-backend:local .",
    "docker:run": "docker run --rm --name welovemovies-backend --publish 5001:5001 --env NODE_ENV=test kernel528/welovemovies-backend:local",
    "docker:stop": "docker rm --force welovemovies-backend",
    "docker:test": "docker build --target test .",
    "docker:smoke": "npm run docker:build && node scripts/smoke-local-image.js",
    "knex": "knex",
    "migrate": "knex migrate:latest",
    "release:bump": "node scripts/release-bump.js",
    "refresh:dev": "node scripts/monthly-refresh.js development",
    "refresh:prod": "node scripts/monthly-refresh.js",
    "smoke:prod": "node scripts/smoke-prod.js",
    "monthly:cleanup-images": "node scripts/cleanup-local-images.js",
    "monthly:verify": "npm run refresh:prod && npm run smoke:prod && npm run monthly:cleanup-images",
    "reset": "npm run rollback && npm run migrate && npm run seed",
    "rollback": "knex migrate:rollback",
    "seed": "knex seed:run",
    "start": "node src/server.js",
    "start:dev": "nodemon src/server.js",
    "swarm:dev-destroy": "node scripts/swarm-dev-destroy.js",
    "swarm:dev-deploy": "node scripts/swarm-dev-deploy.js",
    "swarm:dev-verify": "node scripts/swarm-dev-verify.js",
    "test": "jest",
    "test:coverage": "jest --coverage --runInBand"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^8.2.0",
    "express": "^4.22.2",
    "knex": "2.4.0",
    "morgan": "^1.12.0",
    "nvm": "^0.0.4",
    "pg": "^8.4.2",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "braces": "^3.0.3",
    "jest": "^29.7.0",
    "nodemon": "^3.1.9",
    "supertest": "^6.1.3"
  },
  "overrides": {
    "@babel/core": "7.29.6",
    "brace-expansion": "1.1.18",
    "js-yaml": "3.15.2",
    "qs": "6.16.0"
  },
  "jest": {
    "coverageThreshold": {
      "global": {
        "branches": 60,
        "functions": 90,
        "lines": 90,
        "statements": 90
      }
    }
  }
}
