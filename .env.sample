PORT=5001
NODE_ENV=development

LOCAL_DATABASE_URL=postgresql://user:password@localhost:5432/we_love_movies_local
# The development database on jedi (192.168.1.5) does not use SSL.
DEVELOPMENT_DATABASE_URL=postgresql://user:password@192.168.1.5:5432/chegg_welovemovies_dev
PRODUCTION_DATABASE_URL=postgresql://user:password@host:5432/we_love_movies_prod

APP_URL=http://localhost:5001
SMOKE_BASE_URL=https://your-render-backend.onrender.com

# Docker Swarm development deployment on jedi.
# The dashboard image must be built with VITE_API_BASE_URL=http://192.168.1.5:5001.
SWARM_API_IMAGE=kernel528/welovemovies-backend:dev-latest
SWARM_DASHBOARD_IMAGE=kernel528/welovemovies-frontend:dev-latest
SWARM_API_URL=http://192.168.1.5:5001
SWARM_DASHBOARD_URL=http://192.168.1.5:3002
